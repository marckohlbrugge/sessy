<%#
  One step per screen. The server picks the step from the recorded status
  (SetupsController#show); the polled status line inside the current step
  re-renders the page when that status changes. An earlier step can be
  reopened read-only through ?step=, which renders it without the live line
  or the region form.
%>
<%= render layout: "sources/layout", locals: { source: @source, active: :setup } do %>
  <% readonly = @step != @current_step %>
  <div class="mx-auto max-w-xl text-sm">
    <%= render "progress", current: @current_step %>

    <div class="mt-8">
      <%= render "step_#{%w[connect send done][@step - 1]}", source: @source, readonly: readonly %>
    </div>

    <% if @step > 1 || readonly %>
      <nav aria-label="Other steps" class="mt-10 flex flex-wrap justify-between gap-3 text-zinc-500 dark:text-zinc-400">
        <% if @step > 1 %>
          <%= link_to source_setup_path(@source, step: @step - 1), class: "hover:text-zinc-950 dark:hover:text-white" do %>
            <span aria-hidden="true">&larr;</span> Show step <%= @step - 1 %>
          <% end %>
        <% end %>
        <% if readonly %>
          <%= link_to source_setup_path(@source), class: "ml-auto font-medium text-zinc-950 dark:text-white" do %>
            Continue to step <%= @current_step %> <span aria-hidden="true">&rarr;</span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>
<% end %>
