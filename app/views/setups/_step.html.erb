<%# locals: (number:, title:, state:, summary: nil) %>
<%#
  One setup step. The current step is the only open one; a done step folds
  into a native disclosure whose summary line says what was recorded, so it
  can be reopened without changing anything; an upcoming step is its title
  only, so the user sees what comes next without reading it yet.
%>
<% case state %>
<% when :done %>
  <details class="group border-t border-zinc-950/10 dark:border-white/10 pt-5" data-setup-step="<%= number %>" data-step-state="done">
    <summary class="cursor-pointer select-none flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h2 class="font-semibold inline"><span aria-hidden="true">&#10003;</span> <%= number %>. <%= title %></h2>
      <% if summary %>
        <span class="text-zinc-500 dark:text-zinc-400"><%= summary %></span>
      <% end %>
      <span class="ml-auto text-zinc-500 dark:text-zinc-400 underline">
        <span class="group-open:hidden">Show</span><span class="hidden group-open:inline">Hide</span>
      </span>
    </summary>
    <div class="mt-4"><%= yield %></div>
  </details>
<% when :current %>
  <section class="border-t border-zinc-950/10 dark:border-white/10 pt-5" data-setup-step="<%= number %>" data-step-state="current">
    <h2 class="font-semibold mb-2"><%= number %>. <%= title %></h2>
    <%= yield %>
  </section>
<% else %>
  <section class="border-t border-zinc-950/10 dark:border-white/10 pt-5 text-zinc-400 dark:text-zinc-500" data-setup-step="<%= number %>" data-step-state="upcoming">
    <h2 class="font-semibold"><%= number %>. <%= title %></h2>
  </section>
<% end %>
