<%# locals: (source:, live: false) %>
<%# live: render the polled status line here (only while this is the open step; the frame id must stay unique). %>
<div class="flex flex-wrap items-center gap-3">
  <%= link_to "Launch Stack", launch_stack_url(source), target: "_blank", rel: "noopener noreferrer",
        class: "inline-flex items-center px-3 py-1.5 text-sm font-medium border border-zinc-950 dark:border-white bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 hover:bg-zinc-800 dark:hover:bg-zinc-200" %>
  <span class="text-zinc-500 dark:text-zinc-400">
    <% if source.aws_region_known? %>
      Opens the CloudFormation console in <%= source.aws_region_name %>. Review the stack and click <strong>Create stack</strong>.
    <% else %>
      Opens the CloudFormation console in the AWS region you used last. The review page shows the region at the top —
      check it's the one you send email from, then click <strong>Create stack</strong>.
    <% end %>
  </span>
</div>

<%= render "status", source: source if live %>

<div class="mt-4 space-y-2 text-zinc-500 dark:text-zinc-400">
  <p>
    The stack runs in your AWS account and creates a Configuration Set
    <code class="bg-zinc-100 dark:bg-white/5 px-1 font-mono"><%= config_set_name(source) %></code>,
    an SNS topic
    <code class="bg-zinc-100 dark:bg-white/5 px-1 font-mono"><%= sns_topic_name(source) %></code>,
    an HTTPS subscription to your webhook, and an event destination for every SES event type.
    No IAM roles or users. Sessy never sees your AWS credentials.
  </p>
  <p>
    Already sending with a Configuration Set? Enter its name as
    <code class="bg-zinc-100 dark:bg-white/5 px-1 font-mono">ExistingConfigurationSetName</code>
    on the review page and the stack will attach to it instead of creating a new one.
  </p>
</div>

<%= render "region", source: source %>
