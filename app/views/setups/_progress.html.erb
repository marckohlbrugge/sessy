<%# locals: (current:) %>
<%# Three pill segments plus a label; filled for done and current, muted for upcoming. States are also in text for assistive technology. %>
<nav aria-label="Setup progress" class="flex items-center gap-3">
  <ol class="flex items-center gap-1.5">
    <% (1..3).each do |number| %>
      <% filled = number <= current %>
      <%= tag.li class: "h-2 w-16 rounded-full #{filled ? 'bg-zinc-950 dark:bg-white' : 'bg-zinc-950/10 dark:bg-white/10'}",
            data: ({ filled: true } if filled), aria: { current: ("step" if number == current) } do %>
        <span class="sr-only">Step <%= number %>: <%= setup_step_label(number) %><%= ", done" if number < current %><%= ", current" if number == current %></span>
      <% end %>
    <% end %>
  </ol>
  <span class="text-xs text-zinc-500 dark:text-zinc-400" data-setup-progress-label>Step <%= current %> of 3</span>
</nav>
