<%# locals: (source:) %>
<%#
  Live line for the current step. poll_controller.js reloads this frame until
  the first event is recorded and re-renders the page (Turbo.visit) when the
  status it was rendered with changes, so the step advances from server
  state. The frame carries no src: an eager frame would refetch what the page
  just rendered, and Turbo rejects a frame response whose src points back at
  the request URL, so the controller owns the URL instead. The :complete
  branch only ever answers a poll from a connected page, which then re-renders
  without this frame.
%>
<% status = source.setup_status %>
<% frame_attributes = status == :complete ? {} : { data: { controller: "poll", poll_url_value: source_setup_path(source), poll_status_value: status } } %>
<%= turbo_frame_tag "setup_status", **frame_attributes do %>
  <%= tag.div class: "mt-4 text-zinc-500 dark:text-zinc-400 space-y-1", aria: { live: "polite" }, data: { setup_status: status } do %>
    <% case status %>
    <% when :complete %>
      <p><span aria-hidden="true">&#10003;</span> Receiving events.</p>
    <% when :connected %>
      <p><span class="font-medium text-zinc-950 dark:text-white">Waiting for the first event</span> — this updates automatically.</p>
    <% else %>
      <p><span class="font-medium text-zinc-950 dark:text-white">Waiting for AWS</span> — this updates automatically once the stack is created.</p>
    <% end %>
    <% unless status == :complete %>
      <p data-poll-target="paused" hidden>
        Stopped checking. <%= link_to "Reload", source_setup_path(source), class: "underline", data: { action: "poll#restart" } %> to check again.
      </p>
    <% end %>
  <% end %>
<% end %>
