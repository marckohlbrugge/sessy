<%# locals: (prompt:) %>
<%#
  Copies a server-rendered markdown prompt (Source::AgentInstructions) with
  this source's real values. The text lives in a hidden textarea so it is in
  the DOM for the clipboard controller and for tests.
%>
<div data-controller="clipboard" class="inline-flex">
  <button type="button" data-action="clipboard#copy"
          class="inline-flex items-center gap-2 px-3 py-1.5 text-sm border border-zinc-950/10 dark:border-white/10 hover:border-zinc-950/30 dark:hover:border-white/30 cursor-pointer">
    <svg data-clipboard-target="icon" aria-hidden="true" class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" /></svg>
    <svg data-clipboard-target="checkmark" hidden aria-hidden="true" class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
    <span>Copy instructions for your AI agent</span>
  </button>
  <textarea data-clipboard-target="source" hidden readonly aria-hidden="true" tabindex="-1"><%= prompt %></textarea>
</div>
