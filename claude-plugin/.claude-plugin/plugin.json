{
  "name": "sessy",
  "displayName": "Sessy — AWS SES Observability",
  "description": "Track AWS SES bounces, complaints, and delivery stats from Claude Code. Requires a Sessy API key. Does not send email or change SES settings.",
  "version": "1.0.0",
  "author": {
    "name": "Marc Köhlbrugge",
    "email": "hello@sessy.do"
  },
  "homepage": "https://sessy.do/docs/mcp",
  "privacyPolicyUrl": "https://sessy.do/privacy",
  "repository": "https://github.com/marckohlbrugge/sessy",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "keywords": [
    "amazon-ses",
    "aws-ses",
    "ses",
    "email",
    "observability",
    "deliverability",
    "bounces",
    "complaints",
    "transactional-email",
    "mcp",
    "claude-code"
  ],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Sessy API key",
      "description": "Create one at https://app.sessy.do/api_keys",
      "sensitive": true
    }
  },
  "mcpServers": {
    "sessy": {
      "type": "http",
      "url": "https://api.sessy.do/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
